{
  "name": "metki-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Карта мира с метками, 3D-зданиями Польши и закрытой модерацией",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "emulators": "firebase emulators:start --project demo-metki --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-metki --only firestore \"vitest run --dir tests/rules --no-file-parallelism\"",
    "test:e2e": "playwright test",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "^4.3.3",
    "firebase": "^13.2.0",
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
